+/* The kernel has 256 atom numbers, and the number of each atom that is not
+ * finished holds its BO list. Stay well below that limit, because the tiler
+ * heap is in the BO list of nearly all atoms and use_count is 8 bits. */
+static void
+kbase_throttle_atoms(kbase k)
+{
+        for (;;) {
+                pthread_mutex_lock(&k->handle_lock);
+                uint8_t nr = k->atom_number;
+                bool busy = k->atom_bos[nr].data ||
+                            k->atom_bos[(uint8_t) (nr + 56)].data;
+                pthread_mutex_unlock(&k->handle_lock);
+
+                if (!busy)
+                        return;
+
+                struct kbase_wait_ctx wait = kbase_wait_init(k, 100000000LL);
+                kbase_wait_for_event(&wait);
+                kbase_wait_for_event(&wait);
+                kbase_wait_fini(wait);
+        }
+}
