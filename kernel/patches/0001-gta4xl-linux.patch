+/*
+ * Without Android's hwcomposer nobody unblanks DECON or triggers frames, and the
+ * panel runs in MIPI command mode, so plain fbdev clients (Xorg fbdev) would never
+ * reach the screen. Periodically push the default window to the panel instead.
+ */
+static unsigned int fb_autorefresh_hz = 30;
+module_param(fb_autorefresh_hz, uint, 0644);
+MODULE_PARM_DESC(fb_autorefresh_hz, "fbdev auto refresh rate for DSI command mode, 0 = off");
+
+static struct decon_device *autorefresh_decon;
+static void decon_fb_autorefresh(struct work_struct *work);
+static DECLARE_DELAYED_WORK(decon_autorefresh_work, decon_fb_autorefresh);
+
+static void decon_fb_autorefresh(struct work_struct *work)
+{
+	struct decon_device *decon = autorefresh_decon;
+	struct fb_info *info;
+	unsigned int hz = READ_ONCE(fb_autorefresh_hz);
+
+	if (!decon)
+		return;
+	if (!hz || READ_ONCE(decon_kms_active)) {
+		schedule_delayed_work(&decon_autorefresh_work, HZ);
+		return;
+	}
+
+	info = decon->win[decon->dt.dft_win]->fbinfo;
+	if (lock_fb_info(info)) {
+		if (decon->state == DECON_STATE_INIT)
+			decon_blank(FB_BLANK_UNBLANK, info);
+		if (decon->state == DECON_STATE_ON || IS_DECON_HIBER_STATE(decon))
+			decon_pan_display(&info->var, info);
+		unlock_fb_info(info);
+	}
+
+	schedule_delayed_work(&decon_autorefresh_work, max(1U, HZ / hz));
+}
+
+static void decon_start_autorefresh(struct decon_device *decon)
+{
+	if (decon->id || decon->dt.out_type != DECON_OUT_DSI)
+		return;
+	autorefresh_decon = decon;
+	schedule_delayed_work(&decon_autorefresh_work, 5 * HZ);
+}
