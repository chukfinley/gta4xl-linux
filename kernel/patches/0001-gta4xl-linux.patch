+/* GLib >= 2.74 waits with P_PIDFD as soon as pidfd_open() exists, which this tree has */
+static struct pid *waitid_pidfd_get_pid(unsigned int fd)
+{
+	struct fd f = fdget(fd);
+	struct pid *pid = ERR_PTR(-EBADF);
+
+	if (f.file && f.file->f_op == &pidfd_fops)
+		pid = get_pid(f.file->private_data);
+	fdput(f);
+	return pid;
+}
