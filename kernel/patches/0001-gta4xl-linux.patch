+/* Scan out a buffer that is already mapped into the DPU IOMMU. Caller holds the fb lock. */
+int decon_show_buffer(struct decon_device *decon, dma_addr_t addr,
+		enum decon_pixel_format format, u32 width, u32 height, u32 pitch_px)
+{
+	struct decon_win *win = decon->win[decon->dt.dft_win];
+	struct decon_win_config config;
+	struct decon_mode_info psr;
+	int dpp_id = DPU_DMA2CH(decon->dt.dft_idma);
+	int ret = 0;
+
+	if (decon->dt.out_type != DECON_OUT_DSI)
+		return -ENODEV;
+	if ((!IS_DECON_HIBER_STATE(decon) && IS_DECON_OFF_STATE(decon)) ||
+			decon->state == DECON_STATE_INIT)
+		return -EAGAIN;
+
+	memset(&config, 0, sizeof(config));
+	config.format = format;
+	config.dpp_parm.addr[0] = addr;
+	config.src.w = width;
+	config.src.h = height;
+	config.src.f_w = pitch_px;
+	config.src.f_h = height;
+	config.dst.w = width;
+	config.dst.h = height;
+	config.dst.f_w = decon->lcd_info->xres;
+	config.dst.f_h = decon->lcd_info->yres;
+	if (decon_check_limitation(decon, decon->dt.dft_win, &config) < 0)
+		return -EINVAL;
+
+	decon_hiber_block_exit(decon);
+	decon_to_psr_info(decon, &psr);
+
+	set_bit(dpp_id, &decon->cur_using_dpp);
+	set_bit(dpp_id, &decon->prev_used_dpp);
+	if (v4l2_subdev_call(decon->dpp_sd[dpp_id], core, ioctl, DPP_WIN_CONFIG, &config)) {
+		decon_err("%s: Failed to config DPP-%d\n", __func__, win->dpp_id);
+		decon_reg_win_enable_and_update(decon->id, decon->dt.dft_win, false);
+		clear_bit(dpp_id, &decon->cur_using_dpp);
+		set_bit(dpp_id, &decon->dpp_err_stat);
+		ret = -EIO;
+		goto out;
+	}
+
+	decon_reg_update_req_window(decon->id, win->idx);
+	decon_reg_start(decon->id, &psr);
+out:
+	decon_wait_for_vsync(decon, VSYNC_TIMEOUT_MSEC);
+	if (decon_reg_wait_update_done_and_mask(decon->id, &psr, SHADOW_UPDATE_TIMEOUT) < 0)
+		decon_err("%s: wait_for_update_timeout\n", __func__);
+	decon_hiber_unblock(decon);
+	return ret;
+}
+EXPORT_SYMBOL(decon_show_buffer);
+
 int decon_mmap(struct fb_info *info, struct vm_area_struct *vma)
 {
 	int ret;
diff --git a/drivers/video/fbdev/exynos/dpu20/decon_kms.c b/drivers/video/fbdev/exynos/dpu20/decon_kms.c
new file mode 100644
index 000000000..cd99c68fa
--- /dev/null
+++ b/drivers/video/fbdev/exynos/dpu20/decon_kms.c
@@ -0,0 +1,544 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal DRM/KMS front end for the Exynos DPU20 DECON fbdev driver.
+ *
+ * Exposes the built-in DSI panel as a single CRTC/plane/connector so that
+ * KMS clients (mutter, Xorg modesetting, kmscube) can run. Buffers are ion
+ * dma-bufs mapped into the DPU IOMMU; foreign dma-bufs (e.g. from Mali)
+ * can be imported via PRIME as long as the exporter supports ion_iovmm_map.
+ */
+
+#include <linux/backlight.h>
+#include <linux/dma-buf.h>
+#include <linux/ion_exynos.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include <drm/drmP.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_gem.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+
+#include "decon.h"
+#include "dsim.h"
+
+static bool swap_rb;
+module_param(swap_rb, bool, 0644);
+MODULE_PARM_DESC(swap_rb, "Swap red and blue channels on scanout");
+
+struct dk_device {
+	struct drm_device *drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector connector;
+	struct decon_device *decon;
+	struct device *iommu_dev;
+	struct drm_display_mode mode;
+};
+
+struct dk_bo {
+	struct drm_gem_object base;
+	struct dma_buf *dmabuf;
+	struct dma_buf_attachment *attach;
+	struct sg_table *sgt;
+	dma_addr_t iova;
+};
+
+static inline struct dk_bo *to_dk_bo(struct drm_gem_object *obj)
+{
+	return container_of(obj, struct dk_bo, base);
+}
+
+static inline struct dk_device *to_dk(struct drm_device *drm)
+{
+	return drm->dev_private;
+}
+
+/* ---------------- GEM ---------------- */
+
+static struct dk_bo *dk_bo_wrap(struct drm_device *drm, struct dma_buf *dmabuf)
+{
+	struct dk_device *dk = to_dk(drm);
+	struct dk_bo *bo;
+	int ret;
+
+	bo = kzalloc(sizeof(*bo), GFP_KERNEL);
+	if (!bo)
+		return ERR_PTR(-ENOMEM);
+
+	drm_gem_private_object_init(drm, &bo->base, dmabuf->size);
+
+	get_dma_buf(dmabuf);
+	bo->dmabuf = dmabuf;
+
+	bo->attach = dma_buf_attach(dmabuf, dk->iommu_dev);
+	if (IS_ERR(bo->attach)) {
+		ret = PTR_ERR(bo->attach);
+		goto err_put;
+	}
+
+	bo->sgt = dma_buf_map_attachment(bo->attach, DMA_TO_DEVICE);
+	if (IS_ERR(bo->sgt)) {
+		ret = PTR_ERR(bo->sgt);
+		goto err_detach;
+	}
+
+	bo->iova = ion_iovmm_map(bo->attach, 0, dmabuf->size, DMA_TO_DEVICE, 0);
+	if (IS_ERR_VALUE(bo->iova)) {
+		ret = (int)bo->iova;
+		goto err_unmap;
+	}
+
+	return bo;
+
+err_unmap:
+	dma_buf_unmap_attachment(bo->attach, bo->sgt, DMA_TO_DEVICE);
+err_detach:
+	dma_buf_detach(dmabuf, bo->attach);
+err_put:
+	dma_buf_put(dmabuf);
+	drm_gem_object_release(&bo->base);
+	kfree(bo);
+	return ERR_PTR(ret);
+}
+
+static void dk_gem_free(struct drm_gem_object *obj)
+{
+	struct dk_bo *bo = to_dk_bo(obj);
+
+	drm_gem_free_mmap_offset(obj);
+	ion_iovmm_unmap(bo->attach, bo->iova);
+	dma_buf_unmap_attachment(bo->attach, bo->sgt, DMA_TO_DEVICE);
+	dma_buf_detach(bo->dmabuf, bo->attach);
+	dma_buf_put(bo->dmabuf);
+	drm_gem_object_release(obj);
+	kfree(bo);
+}
+
+static int dk_dumb_create(struct drm_file *file, struct drm_device *drm,
+			  struct drm_mode_create_dumb *args)
+{
+	struct dma_buf *dmabuf;
+	struct dk_bo *bo;
+	int ret;
+
+	if (!args->width || !args->height || args->bpp != 32)
+		return -EINVAL;
+
+	args->pitch = ALIGN(args->width * 4, 64);
+	args->size = PAGE_ALIGN((u64)args->pitch * args->height);
+
+	dmabuf = ion_alloc_dmabuf("ion_system_heap", args->size, 0);
+	if (IS_ERR(dmabuf))
+		return PTR_ERR(dmabuf);
+
+	bo = dk_bo_wrap(drm, dmabuf);
+	dma_buf_put(dmabuf);
+	if (IS_ERR(bo))
+		return PTR_ERR(bo);
+
+	ret = drm_gem_handle_create(file, &bo->base, &args->handle);
+	drm_gem_object_put_unlocked(&bo->base);
+	return ret;
+}
+
+static int dk_dumb_map_offset(struct drm_file *file, struct drm_device *drm,
+			      u32 handle, u64 *offset)
+{
+	struct drm_gem_object *obj;
+	int ret;
+
+	obj = drm_gem_object_lookup(file, handle);
+	if (!obj)
+		return -ENOENT;
+
+	ret = drm_gem_create_mmap_offset(obj);
+	if (!ret)
+		*offset = drm_vma_node_offset_addr(&obj->vma_node);
+
+	drm_gem_object_put_unlocked(obj);
+	return ret;
+}
+
+static int dk_mmap(struct file *filp, struct vm_area_struct *vma)
+{
+	struct drm_file *priv = filp->private_data;
+	struct drm_device *drm = priv->minor->dev;
+	struct drm_vma_offset_node *node;
+	struct drm_gem_object *obj = NULL;
+	int ret;
+
+	drm_vma_offset_lock_lookup(drm->vma_offset_manager);
+	node = drm_vma_offset_exact_lookup_locked(drm->vma_offset_manager,
+						  vma->vm_pgoff, vma_pages(vma));
+	if (node) {
+		obj = container_of(node, struct drm_gem_object, vma_node);
+		if (!kref_get_unless_zero(&obj->refcount))
+			obj = NULL;
+	}
+	drm_vma_offset_unlock_lookup(drm->vma_offset_manager);
+
+	if (!obj)
+		return -EINVAL;
+
+	if (!drm_vma_node_is_allowed(node, priv)) {
+		ret = -EACCES;
+		goto out;
+	}
+
+	vma->vm_pgoff = 0;
+	ret = dma_buf_mmap(to_dk_bo(obj)->dmabuf, vma, 0);
+out:
+	drm_gem_object_put_unlocked(obj);
+	return ret;
+}
+
+static struct dma_buf *dk_prime_export(struct drm_device *drm,
+				       struct drm_gem_object *obj, int flags)
+{
+	struct dk_bo *bo = to_dk_bo(obj);
+
+	get_dma_buf(bo->dmabuf);
+	return bo->dmabuf;
+}
+
+static struct drm_gem_object *dk_prime_import(struct drm_device *drm,
+					      struct dma_buf *dmabuf)
+{
+	struct dk_bo *bo = dk_bo_wrap(drm, dmabuf);
+
+	return IS_ERR(bo) ? ERR_CAST(bo) : &bo->base;
+}
+
+/* ---------------- KMS ---------------- */
+
+static int dk_format(u32 drm_format, enum decon_pixel_format *out)
+{
+	bool bgr;
+
+	switch (drm_format) {
+	case DRM_FORMAT_XRGB8888:
+	case DRM_FORMAT_ARGB8888:
+		bgr = true;
+		break;
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_ABGR8888:
+		bgr = false;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (swap_rb)
+		bgr = !bgr;
+
+	/* DECON names follow memory byte order, DRM names a little-endian word */
+	*out = bgr ? DECON_PIXEL_FORMAT_BGRX_8888 : DECON_PIXEL_FORMAT_RGBX_8888;
+	return 0;
+}
+
+static void dk_scanout(struct dk_device *dk, struct drm_framebuffer *fb)
+{
+	struct decon_device *decon = dk->decon;
+	struct fb_info *info = decon->win[decon->dt.dft_win]->fbinfo;
+	enum decon_pixel_format fmt;
+	struct dk_bo *bo;
+
+	if (!fb || dk_format(fb->format->format, &fmt))
+		return;
+
+	bo = to_dk_bo(drm_gem_fb_get_obj(fb, 0));
+
+	if (!lock_fb_info(info))
+		return;
+	if (decon->state == DECON_STATE_INIT || decon->state == DECON_STATE_OFF)
+		decon_kms_blank(decon, FB_BLANK_UNBLANK);
+	decon_show_buffer(decon, bo->iova + fb->offsets[0], fmt,
+			  fb->width, fb->height, fb->pitches[0] / 4);
+	unlock_fb_info(info);
+}
+
+static void dk_send_event(struct drm_crtc *crtc)
+{
+	struct drm_pending_vblank_event *event = crtc->state->event;
+
+	if (!event)
+		return;
+
+	crtc->state->event = NULL;
+	spin_lock_irq(&crtc->dev->event_lock);
+	drm_crtc_send_vblank_event(crtc, event);
+	spin_unlock_irq(&crtc->dev->event_lock);
+}
+
+/*
+ * DPMS switches the backlight only. After decon_disable the DPP never raises its frame
+ * interrupt again ("DPP[2] irq hasn't been occured"), so the display stays black.
+ */
+static void dk_backlight(bool on)
+{
+	static int saved = -1;
+	struct backlight_device *bd = backlight_device_get_by_type(BACKLIGHT_RAW);
+
+	if (!bd)
+		return;
+	mutex_lock(&bd->update_lock);
+	if (on && saved >= 0) {
+		bd->props.brightness = saved;
+		saved = -1;
+	} else if (!on && saved < 0) {
+		saved = bd->props.brightness;
+		bd->props.brightness = 0;
+	}
+	backlight_update_status(bd);
+	mutex_unlock(&bd->update_lock);
+}
+
+static void dk_pipe_enable(struct drm_simple_display_pipe *pipe,
+			   struct drm_crtc_state *crtc_state)
+{
+	struct dk_device *dk = to_dk(pipe->crtc.dev);
+
+	WRITE_ONCE(decon_kms_active, true);
+	dk_scanout(dk, pipe->plane.state->fb);
+	dk_backlight(true);
+	dk_send_event(&pipe->crtc);
+}
+
+static void dk_pipe_disable(struct drm_simple_display_pipe *pipe)
+{
+	dk_backlight(false);
+	dk_send_event(&pipe->crtc);
+}
+
+static int dk_pipe_check(struct drm_simple_display_pipe *pipe,
+			 struct drm_plane_state *plane_state,
+			 struct drm_crtc_state *crtc_state)
+{
+	struct dk_device *dk = to_dk(pipe->crtc.dev);
+	struct drm_framebuffer *fb = plane_state->fb;
+	enum decon_pixel_format fmt;
+
+	if (!fb)
+		return 0;
+	if (dk_format(fb->format->format, &fmt))
+		return -EINVAL;
+	if (fb->width != dk->mode.hdisplay || fb->height != dk->mode.vdisplay ||
+	    plane_state->crtc_x || plane_state->crtc_y ||
+	    plane_state->crtc_w != dk->mode.hdisplay ||
+	    plane_state->crtc_h != dk->mode.vdisplay ||
+	    plane_state->src_x || plane_state->src_y)
+		return -EINVAL;
+	if (fb->pitches[0] % 4)
+		return -EINVAL;
+	return 0;
+}
+
+static void dk_pipe_update(struct drm_simple_display_pipe *pipe,
+			   struct drm_plane_state *old_state)
+{
+	struct dk_device *dk = to_dk(pipe->crtc.dev);
+
+	if (pipe->crtc.state->active)
+		dk_scanout(dk, pipe->plane.state->fb);
+	dk_send_event(&pipe->crtc);
+}
+
+static int dk_pipe_prepare_fb(struct drm_simple_display_pipe *pipe,
+			      struct drm_plane_state *plane_state)
+{
+	return drm_gem_fb_prepare_fb(&pipe->plane, plane_state);
+}
+
+static const struct drm_simple_display_pipe_funcs dk_pipe_funcs = {
+	.enable = dk_pipe_enable,
+	.disable = dk_pipe_disable,
+	.check = dk_pipe_check,
+	.update = dk_pipe_update,
+	.prepare_fb = dk_pipe_prepare_fb,
+};
+
+static int dk_fb_dirty(struct drm_framebuffer *fb, struct drm_file *file,
+		       unsigned int flags, unsigned int color,
+		       struct drm_clip_rect *clips, unsigned int num_clips)
+{
+	struct dk_device *dk = to_dk(fb->dev);
+	struct drm_simple_display_pipe *pipe = &dk->pipe;
+
+	drm_modeset_lock_all(fb->dev);
+	if (pipe->plane.state->fb == fb && pipe->crtc.state->active)
+		dk_scanout(dk, fb);
+	drm_modeset_unlock_all(fb->dev);
+	return 0;
+}
+
+static const struct drm_framebuffer_funcs dk_fb_funcs = {
+	.destroy = drm_gem_fb_destroy,
+	.create_handle = drm_gem_fb_create_handle,
+	.dirty = dk_fb_dirty,
+};
+
+static struct drm_framebuffer *dk_fb_create(struct drm_device *drm,
+					    struct drm_file *file,
+					    const struct drm_mode_fb_cmd2 *cmd)
+{
+	return drm_gem_fb_create_with_funcs(drm, file, cmd, &dk_fb_funcs);
+}
+
+static const struct drm_mode_config_funcs dk_mode_config_funcs = {
+	.fb_create = dk_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+static int dk_conn_get_modes(struct drm_connector *connector)
+{
+	struct dk_device *dk = to_dk(connector->dev);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &dk->mode);
+	if (!mode)
+		return 0;
+
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = dk->decon->lcd_info->width;
+	connector->display_info.height_mm = dk->decon->lcd_info->height;
+	return 1;
+}
+
+static const struct drm_connector_helper_funcs dk_conn_helper_funcs = {
+	.get_modes = dk_conn_get_modes,
+};
+
+static const struct drm_connector_funcs dk_conn_funcs = {
+	.reset = drm_atomic_helper_connector_reset,
+	.fill_modes = drm_helper_probe_single_connector_modes,
+	.destroy = drm_connector_cleanup,
+	.atomic_duplicate_state = drm_atomic_helper_connector_duplicate_state,
+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+
+static const u32 dk_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_ARGB8888,
+	DRM_FORMAT_XBGR8888,
+	DRM_FORMAT_ABGR8888,
+};
+
+static const struct file_operations dk_fops = {
+	.owner = THIS_MODULE,
+	.open = drm_open,
+	.release = drm_release,
+	.unlocked_ioctl = drm_ioctl,
+	.compat_ioctl = drm_compat_ioctl,
+	.poll = drm_poll,
+	.read = drm_read,
+	.llseek = noop_llseek,
+	.mmap = dk_mmap,
+};
+
+static struct drm_driver dk_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC | DRIVER_PRIME,
+	.fops = &dk_fops,
+	.gem_free_object_unlocked = dk_gem_free,
+	.dumb_create = dk_dumb_create,
+	.dumb_map_offset = dk_dumb_map_offset,
+	.dumb_destroy = drm_gem_dumb_destroy,
+	.prime_handle_to_fd = drm_gem_prime_handle_to_fd,
+	.prime_fd_to_handle = drm_gem_prime_fd_to_handle,
+	.gem_prime_export = dk_prime_export,
+	.gem_prime_import = dk_prime_import,
+	.name = "decon-kms",
+	.desc = "Exynos DECON KMS front end",
+	.date = "20261015",
+	.major = 1,
+	.minor = 0,
+};
+
+static void dk_init_mode(struct dk_device *dk)
+{
+	struct decon_lcd *lcd = dk->decon->lcd_info;
+	struct drm_display_mode *m = &dk->mode;
+
+	m->hdisplay = lcd->xres;
+	m->hsync_start = m->hdisplay + lcd->hfp;
+	m->hsync_end = m->hsync_start + lcd->hsa;
+	m->htotal = m->hsync_end + lcd->hbp;
+	m->vdisplay = lcd->yres;
+	m->vsync_start = m->vdisplay + lcd->vfp;
+	m->vsync_end = m->vsync_start + lcd->vsa;
+	m->vtotal = m->vsync_end + lcd->vbp;
+	m->clock = DIV_ROUND_UP(m->htotal * m->vtotal * 60, 1000);
+	m->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	m->width_mm = lcd->width;
+	m->height_mm = lcd->height;
+	drm_mode_set_name(m);
+}
+
+static int __init decon_kms_init(void)
+{
+	struct decon_device *decon = get_decon_drvdata(0);
+	struct dsim_device *dsim;
+	struct drm_device *drm;
+	struct dk_device *dk;
+	int ret;
+
+	if (!decon || decon->dt.out_type != DECON_OUT_DSI || !decon->out_sd[0])
+		return -ENODEV;
+
+	dk = kzalloc(sizeof(*dk), GFP_KERNEL);
+	if (!dk)
+		return -ENOMEM;
+
+	dsim = v4l2_get_subdevdata(decon->out_sd[0]);
+	dk->decon = decon;
+	dk->iommu_dev = dsim->dev;
+	dk_init_mode(dk);
+
+	drm = drm_dev_alloc(&dk_driver, decon->dev);
+	if (IS_ERR(drm)) {
+		ret = PTR_ERR(drm);
+		goto err_free;
+	}
+	dk->drm = drm;
+	drm->dev_private = dk;
+
+	drm_mode_config_init(drm);
+	drm->mode_config.min_width = dk->mode.hdisplay;
+	drm->mode_config.min_height = dk->mode.vdisplay;
+	drm->mode_config.max_width = dk->mode.hdisplay;
+	drm->mode_config.max_height = dk->mode.vdisplay;
+	drm->mode_config.preferred_depth = 24;
+	drm->mode_config.funcs = &dk_mode_config_funcs;
+
+	drm_connector_helper_add(&dk->connector, &dk_conn_helper_funcs);
+	ret = drm_connector_init(drm, &dk->connector, &dk_conn_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (ret)
+		goto err_config;
+
+	ret = drm_simple_display_pipe_init(drm, &dk->pipe, &dk_pipe_funcs,
+					   dk_formats, ARRAY_SIZE(dk_formats),
+					   NULL, &dk->connector);
+	if (ret)
+		goto err_config;
+
+	drm_mode_config_reset(drm);
+
+	ret = drm_dev_register(drm, 0);
+	if (ret)
+		goto err_config;
+
+	DRM_INFO("decon-kms: %ux%u on decon%d\n",
+		 dk->mode.hdisplay, dk->mode.vdisplay, decon->id);
+	return 0;
+
+err_config:
+	drm_mode_config_cleanup(drm);
+	drm_dev_unref(drm);
+err_free:
+	kfree(dk);
+	return ret;
+}
+late_initcall(decon_kms_init);
