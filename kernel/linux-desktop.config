# Linux desktop (systemd + GNOME) requirements on top of exynos9611-gta4xl_defconfig
CONFIG_LOCALVERSION="-gta4xl-linux"
# CONFIG_LOCALVERSION_AUTO is not set

# Android-only restrictions that break a normal userland
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=0

# Console
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
# fbcon deadlocks against DECON's unblank path (console_lock), so VTs use the dummy console
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_PRINTK_TIME=y

# systemd
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS4_FS=y
CONFIG_FHANDLE=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# CONFIG_SYSFS_DEPRECATED is not set
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_DMIID=y
CONFIG_RTC_CLASS=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_FUSE_FS=y

# USB gadget networking for the debug shell
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Bluetooth through BlueZ instead of the Android HAL char device
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HS=y
CONFIG_BT_LE=y
CONFIG_SCSC_BT_BLUEZ=y
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# WLAN firmware from the Linux rootfs
CONFIG_SCSC_CORE_FW_LOCATION="/lib/firmware/scsc"
CONFIG_SCSC_CORE_TOOL_LOCATION="/usr/lib/scsc"
CONFIG_SCSC_WLAN_MAC_ADDRESS_FILENAME="/efs/wifi/.mac.info"
CONFIG_SCSC_BT_ADDRESS_FILENAME="/efs/bluetooth/bt_addr"

# DRM base for the DECON KMS bridge
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER_BUILTIN=y
CONFIG_EXYNOS_DECON_KMS=y
# CONFIG_DRM_FBDEV_EMULATION is not set
CONFIG_DMA_CMA=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y

# Debug checks flood the log on each IPv6 packet: load 18 on an idle desktop
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_LIST is not set

# The bootloader ignores the boot.img cmdline, so audit=0 has no effect: kauditd floods the log
# CONFIG_AUDIT is not set

# GNOME and BlueZ switch radios through rfkill
CONFIG_RFKILL=y
