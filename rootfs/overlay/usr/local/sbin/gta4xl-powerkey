#!/usr/bin/env python3
"""Short press on Power switches the panel off and on through mutter, and deep sleep follows.
A press of LOCK_HOLD seconds or more locks the session. Nothing else locks it after the boot.

logind ignores the key and gsd-power has no such action. Works on the greeter too: the greeter
runs on a private session bus, so the bus address comes from the gnome-shell environment.

The tablet goes to system sleep when the panel was off for SLEEP_AFTER seconds, on battery only,
with no audio stream and no sleep inhibitor. The system-sleep hook sends SIGUSR1 after resume,
then the panel goes on. Power is a wake key, its press also arrives as an input event.
"""
import fcntl
import glob
import os
import select
import signal
import struct
import subprocess
import time

KEY_POWER = 116
EV_KEY = 1
EVIOCGRAB = 0x40044590
EVENT = struct.Struct("qqHHi")
PATH = ["org.gnome.Mutter.DisplayConfig", "/org/gnome/Mutter/DisplayConfig",
        "org.gnome.Mutter.DisplayConfig", "PowerSaveMode"]
BATTERY = "/sys/class/power_supply/battery/status"
SLEEP_AFTER = 120
LOCK_HOLD = 1.0
TICK = 20
# The key press that ended sleep arrives after the resume signal, it must not switch the panel off
RESUME_GUARD = 3


def event_node(name):
    for path in glob.glob("/sys/class/input/event*/device/name"):
        if open(path).read().strip() == name:
            return "/dev/input/" + path.split("/")[4]
    raise SystemExit(f"{name} not found")


def shell():
    """(user, bus address) of the gnome-shell on the active seat session."""
    out = subprocess.run(["pgrep", "-n", "-x", "gnome-shell"], capture_output=True, text=True)
    pid = out.stdout.strip()
    if not pid:
        return None
    env = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
    bus = next((e[len(b"DBUS_SESSION_BUS_ADDRESS="):].decode() for e in env
                if e.startswith(b"DBUS_SESSION_BUS_ADDRESS=")), None)
    user = subprocess.run(["ps", "-o", "user=", "-p", pid], capture_output=True, text=True).stdout.strip()
    return (user, bus) if bus else None


def run_as(user, cmd, **env):
    """Without PAM, runuser writes two log lines for each call."""
    return subprocess.run(cmd, user=user, group=user, extra_groups=[], env=env,
                          capture_output=True, text=True).stdout


def busctl(user, bus, *args):
    return run_as(user, ["busctl", "--user", *args], DBUS_SESSION_BUS_ADDRESS=bus)


def panel_on():
    """From the connector: a D-Bus call after a key press sees the state after mutter woke up."""
    return open(glob.glob("/sys/class/drm/card0-*/dpms")[0]).read().strip() == "On"


def set_panel(target, touch, on):
    busctl(*target, "set-property", *PATH, "i", "0" if on else "3")
    # mutter wakes up on any input: a touch in the bag must not switch the panel on
    try:
        fcntl.ioctl(touch, EVIOCGRAB, 0 if on else 1)
    except OSError:
        pass  # It already has this state: the panel also goes off through GNOME


def audio_active():
    return "[active]" in run_as("user", ["wpctl", "status"], XDG_RUNTIME_DIR="/run/user/1000")


def sleep_blocked():
    out = subprocess.run(["systemd-inhibit", "--list", "--mode=block", "--no-legend", "--no-pager"],
                         capture_output=True, text=True).stdout
    return any("sleep" in line for line in out.splitlines())


def on_battery():
    try:
        return open(BATTERY).read().strip() == "Discharging"
    except OSError:
        return False


def main():
    touch = open(event_node("sec_touchscreen"), "rb")
    key = os.open(event_node("gpio_keys"), os.O_RDONLY)
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.signal(signal.SIGUSR1, lambda *_: None)
    signal.set_wakeup_fd(wake_w)

    off_since = None
    resumed = 0.0
    was_on = None
    pressed = 0.0
    while True:
        ready = select.select([key, wake_r], [], [], TICK)[0]

        if wake_r in ready:
            os.read(wake_r, 64)
            resumed = time.monotonic()
            off_since = None
            target = shell()
            if target:
                set_panel(target, touch, True)

        if key in ready:
            data = os.read(key, EVENT.size * 16)
            for offset in range(0, len(data), EVENT.size):
                _, _, typ, code, value = EVENT.unpack_from(data, offset)
                if typ != EV_KEY or code != KEY_POWER or time.monotonic() - resumed < RESUME_GUARD:
                    continue
                if value == 1:
                    was_on = panel_on()
                    pressed = time.monotonic()
                elif value == 0 and was_on is not None:
                    if time.monotonic() - pressed >= LOCK_HOLD:
                        subprocess.run(["loginctl", "lock-sessions"])
                        was_on = None
                        continue
                    # On release: mutter also wakes on the release, after the panel went off
                    time.sleep(0.1)
                    target = shell()
                    if target:
                        set_panel(target, touch, not was_on)
                    was_on = None
            continue

        if panel_on():
            off_since = None
            continue
        off_since = off_since or time.monotonic()
        if time.monotonic() - off_since >= SLEEP_AFTER:
            # Try again one period later if a condition does not hold or sleep fails
            off_since = None
            if on_battery() and not audio_active() and not sleep_blocked():
                subprocess.run(["systemctl", "suspend"])


if __name__ == "__main__":
    main()
