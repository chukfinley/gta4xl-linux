#!/bin/sh
# USB serial console (ttyGS0). ECM and NCM move no data in this kernel: all TX requests stay
# queued, the net device then returns TX_BUSY in a loop and one CPU core runs at 100 %.
set -e

G=/sys/kernel/config/usb_gadget/g1
mountpoint -q /sys/kernel/config || mount -t configfs configfs /sys/kernel/config

if [ "$1" = "stop" ]; then
	echo "" > $G/UDC 2>/dev/null || true
	exit 0
fi

# The initramfs already bound the gadget
[ -n "$(cat $G/UDC 2>/dev/null)" ] && exit 0

mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409
echo 0x18d1 > $G/idVendor
echo 0xd002 > $G/idProduct
echo gta4xl-linux > $G/strings/0x409/serialnumber
echo Samsung > $G/strings/0x409/manufacturer
echo "Galaxy Tab S6 Lite (Ubuntu)" > $G/strings/0x409/product
echo "acm" > $G/configs/c.1/strings/0x409/configuration

mkdir -p $G/functions/acm.usb0
[ -e $G/configs/c.1/acm.usb0 ] || ln -s $G/functions/acm.usb0 $G/configs/c.1/

ls /sys/class/udc | head -n 1 > $G/UDC
