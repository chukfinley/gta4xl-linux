# The Wacom driver reports no resolution, libinput then ignores the pen. 100 units per mm.
evdev:name:sec_e-pen:*
 EVDEV_ABS_00=::100
 EVDEV_ABS_01=::100

# The Targus keyboard has no Super key in Android mode. Caps Lock becomes Super: overview, shortcuts.
evdev:name:Targus THZ858 Keyboard:*
 KEYBOARD_KEY_70039=leftmeta
