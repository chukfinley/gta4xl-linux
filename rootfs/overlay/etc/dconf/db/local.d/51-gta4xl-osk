# GJS OSK: no edge swipe, the bottom edge belongs to the overview. Layout index: 2 Tenkeyless
# International, 4 Compact International.
[org/gnome/shell/extensions/gjsosk]
disable-edge-swipe=true
enable-tap-gesture=1
indicator-enabled=true
enable-drag=false
play-sound=false
enable-key-repeat=true
layout-landscape=2
layout-portrait=4
landscape-width-percent=100
landscape-height-percent=40
portrait-width-percent=100
portrait-height-percent=28
font-size-px=16
