# Suspend does not resume on this kernel. Power toggles the panel, see gta4xl-powerkey.
[org/gnome/settings-daemon/plugins/power]
power-button-action='nothing'
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org/gnome/desktop/a11y/applications]
screen-keyboard-enabled=true

[org/gnome/shell]
enabled-extensions=['tablet-shell@gnome-tablet', 'gta4xl-tablet@gta4xl']
favorite-apps=['brave-browser.desktop', 'org.gnome.Nautilus.desktop', 't3code.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Settings.desktop']

[org/gnome/desktop/interface]
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'
cursor-theme='Adwaita'
color-scheme='prefer-dark'
clock-show-weekday=true
show-battery-percentage=true

[org/gnome/desktop/wm/preferences]
button-layout=':'

[org/gnome/mutter]
experimental-features=['scale-monitor-framebuffer']
dynamic-workspaces=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/tablet-shell.jpg'
picture-uri-dark='file:///usr/share/backgrounds/tablet-shell.jpg'
primary-color='#000000'
secondary-color='#000000'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/tablet-shell.jpg'
primary-color='#000000'

[org/gnome/desktop/screensaver]
lock-enabled=false
lock-delay=uint32 0

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/shell/extensions/tablet-shell]
battery-stats-command='akku-statistik --text'

[org/gnome/desktop/app-folders]
folder-children=['Utilities', 'System']

[org/gnome/desktop/app-folders/folders/Utilities]
name='Utilities'
categories=['Utility']
translate=false

[org/gnome/desktop/app-folders/folders/System]
name='System'
categories=['System', 'Settings']
translate=false
