#!/bin/sh
# The firmware scans for a better AP every 25 s on one strong AP, and the AP then drops the tablet
# with deauth reason 7. Only roam on a very weak signal.
# A firmware restart or a new association clears these values, so run at each of these events.
[ "$1" = wlan0 ] || exit 0
case "$2" in up|dhcp4-change|reapply) ;; *) exit 0 ;; esac
/usr/bin/python3 /usr/local/sbin/gta4xl-wlan-cmd wlan0 "SETNCHOMODE 1" "SETROAMTRIGGER -100" "SETROAMDELTA 100" "SETROAMSCANPERIOD 60" >/dev/null 2>&1
exit 0
