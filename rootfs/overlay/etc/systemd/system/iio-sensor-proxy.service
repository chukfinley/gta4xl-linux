# Replaces the package unit: see /usr/local/sbin/gta4xl-sensors
[Unit]
Description=Sensor hub bridge for GNOME (net.hadess.SensorProxy)

[Service]
Type=dbus
BusName=net.hadess.SensorProxy
ExecStart=/usr/bin/python3 /usr/local/sbin/gta4xl-sensors
Restart=on-failure

[Install]
WantedBy=graphical.target
